# ---------------------------------------------------------------------------
# Charicha Institute — environment template
#
#   cp .env.example .env.local     # then fill in the values below
#
# .env.local is gitignored. Never commit real values.
# ---------------------------------------------------------------------------


# === Firebase — REQUIRED ====================================================
#
# Firebase backs user accounts, user-written articles, and file storage.
# These are needed to BUILD, not just to run: several pages pull Firebase in
# through getStaticProps, so `next build` fails with `auth/invalid-api-key`
# if they are missing or malformed.
#
# Where to get them:
#   Firebase Console -> your project -> Project settings (gear icon)
#   -> General -> Your apps -> Web app -> "SDK setup and configuration"
#   -> select "Config". Copy each field across.
#
# NOTE ON SECRECY: these are client-side config, not credentials. They are
# deliberately shipped to the browser (via the `env` block in next.config.js),
# which is normal for Firebase web apps — access is enforced by Firestore
# Security Rules, not by hiding these. Still keep .env.local out of git.

FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
FIREBASE_PROJECT_ID=your-project
FIREBASE_STORAGE_BUCKET=your-project.appspot.com
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
FIREBASE_MEASUREMENT_ID=


# === Sanity CMS — OPTIONAL ==================================================
#
# Leave these blank and the site still works: every CMS-backed page falls back
# to the bundled static content in lib/sanity/fallbacks.js, and /blog simply
# shows Firebase articles only. See SANITY.md.
#
# Fill them in to turn the CMS on. PROJECT_ID comes from sanity.io/manage
# (or `npx sanity init` in studio/). Must match studio/.env.

NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2024-01-01


# ---------------------------------------------------------------------------
# Removed — do not re-add
#
#   MONGODB_URI / DB_NAME
#     lib/mongodb.js had zero callers and threw at import time if these were
#     unset. Deleted along with the `mongodb` dependency.
#
#   AUTH0_* 
#     @auth0/nextjs-auth0 was installed with a live /api/auth/[...auth0]
#     route, but nothing in the app ever called it — real auth is Firebase.
#     Route and dependency both deleted.
# ---------------------------------------------------------------------------
